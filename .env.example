# Orb Backend — environment configuration
# Copy to .env and fill in. Nothing here is optional-with-a-shipped-default-secret:
# every credential is yours. Full explanations: SELF_HOSTING.md §5.
# (Legacy JARVIS_* spellings of any ORB_* variable still work — orb_env.py maps them.)

# ── Required ──────────────────────────────────────────────────────────────────
# Shared secret between your backend and the Orb app. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (Auto-generated and persisted here on first boot if you leave it empty.)
ORB_TOKEN=

# ── Identity ──────────────────────────────────────────────────────────────────
USER_NAME=
ORB_PERSONA=orb               # orb | jarvis | ultron
# TTS_VOICE=                     # Edge-TTS voice override (persona default otherwise)
ORB_DEFAULT_LOCATION=New York # weather fallback when no location is spoken
# ORB_PORT=8340                  # HTTP/WS bind port (moves /mcp + internal URLs too)

# ── Security ──────────────────────────────────────────────────────────────────
# 1 = HTTP /api/* requires X-Jarvis-Token too (the WS always requires the token).
# Recommended whenever your URL is reachable beyond your LAN. Needs an app version
# that sends the header.
ORB_HTTP_AUTH=0

# ── Brain ─────────────────────────────────────────────────────────────────────
# Default conversational brain. Claude tiers run through YOUR logged-in Claude Code
# CLI (`claude -p`) — no API key, ever. grok/codex need those CLIs installed.
ORB_SPINE_BRAIN=haiku         # haiku|sonnet|opus|grok|grok-build|codex|codex-mini|codex-full|local
# ORB_FREE_BACKENDS=[]        # JSON [{name, base_url, model, api_key_env}, ...]
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b        # local floor (full local tier: on the roadmap)

# ── Voice input (local Whisper) ───────────────────────────────────────────────
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cpu             # cpu | cuda
# WHISPER_COMPUTE=int8

# ── Push notifications (optional — paid Apple Developer account) ─────────────
# Key with APNs enabled from developer.apple.com; the .p8 goes in the repo root
# (gitignored — NEVER commit it).
# APNS_KEY_PATH=AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_ENV=auto                  # auto tries production + sandbox

# ── Mail (optional, read-only Gmail) ──────────────────────────────────────────
# Google Account -> Security -> 2-Step Verification -> App passwords.
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# ── Vision (optional) ─────────────────────────────────────────────────────────
# Free key at aistudio.google.com; falls back to `claude -p` when unset.
# GEMINI_API_KEY=

# ── Proactive layer ───────────────────────────────────────────────────────────
# ORB_SYNTHESIS_HOURS=6,18    # fixed clock hours for the twice-daily synthesis
# ORB_SYNTHESIS_MODEL=sonnet
# ORB_MAX_EXTRA_REVIEWS=2
# ORB_SCHED_GRACE_H=18        # missed-while-off reminders still fire (marked late)
# ORB_ALERT_BOOT_GRACE_S=600  # no direct system alerts this soon after a boot
# ORB_PROJECT_DIRS=           # JSON [[label, path], ...] the engine watches, e.g.
#   [["MyApp", "~/Desktop/MyApp"], ["Thesis", "~/Documents/thesis"]]

# ── The mind (between-conversation agency) ────────────────────────────────────
# ORB_MIND=1                  # 0 = off
# ORB_MIND_MAX_WAKES=10
# ORB_MIND_MAX_EXPRESS=8      # self-initiated notifications/day
# ORB_MIND_EXPRESS_GAP_MIN=45

# ── Advanced / rarely touched ─────────────────────────────────────────────────
# ORB_MCP_BRAIN=1             # Claude-family turns as one `claude -p` + MCP tools
# ORB_MCP_TURN_TIMEOUT=90     # seconds before a turn hands off to the late finisher
# ORB_MCP_LATE_CAP=600
# ORB_AGENT_SPINE=1
# ORB_PARALLEL_TOOLS=0
# ORB_ACK=0                   # spoken instant-ack before slow answers
# ORB_MEMORY=0                # long-term memory extraction (needs local model)
# ORB_WS_NOTIFICATIONS=1
# ORB_NOTIFY_TOPIC_COOLDOWN_H=8
# ORB_SESSION_CHECKBACK_MIN=20
# ORB_SESSION_PROGRESS=1          # live progress pushes for delegated sessions
# ORB_SESSION_PROGRESS_AFTER_S=90 # only push once a session has run this long
# ORB_SESSION_PROGRESS_EVERY_S=240# min gap between progress pushes
# CLAUDE_MODEL=
